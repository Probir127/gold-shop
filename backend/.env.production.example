# ==============================================================================
# Sahara Gold - Render Production Environment Variables Reference
# Set these in your Render Web Service Dashboard (Environment tab)
# ==============================================================================

# General
DEBUG=False
SECRET_KEY=generate-a-secure-random-string-with-at-least-50-characters-here
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1
# Note: Render automatically provides RENDER_EXTERNAL_HOSTNAME, which Django automatically adds.

# Database
# If using Render PostgreSQL: Render automatically sets DATABASE_URL when you link the database.
# If using Neon / Supabase: Paste your connection string here:
# DATABASE_URL=postgresql://user:password@host:5432/sahara_gold?sslmode=require

# Web / Origins (Replace with your actual Render service names)
# e.g. Frontend: https://sahara-gold-store.onrender.com
# e.g. Backend:  https://sahara-gold-api.onrender.com
FRONTEND_URL=https://sahara-gold.onrender.com
BACKEND_URL=https://sahara-gold-backend.onrender.com
CORS_ALLOWED_ORIGINS=https://sahara-gold.onrender.com
CSRF_TRUSTED_ORIGINS=https://sahara-gold.onrender.com,https://*.onrender.com

# Initial Data & Superuser Setup (Optional on first build)
AUTO_POPULATE_DATA=True
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=ChangeThisPasswordToSomethingSecure123!

# Payment Gateway (SSLCommerz)
# For testing free hosting, set ALLOW_SANDBOX_PAYMENTS=True and use test credentials:
SSLCOMMERZ_IS_SANDBOX=True
ALLOW_SANDBOX_PAYMENTS=True
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASS=qwerty

# Email Backend (Defaults to console logger if password is blank)
# To use Gmail SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-gmail-16-char-app-password
# DEFAULT_FROM_EMAIL=your-email@gmail.com
# STORE_EMAIL=your-email@gmail.com

# AI / LLM Configuration (Optional)
HUGGINGFACE_API_KEY=
AI_MODEL=Qwen/Qwen2.5-72B-Instruct
