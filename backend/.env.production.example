# ==============================================================================
# New Sahara Gold and Diamond - Production Environment Reference
# Set these in your Render Web Service Dashboard (Environment tab)
# ==============================================================================

# General
DEBUG=False
SECRET_KEY=generate-a-secure-random-string-with-at-least-50-characters-here
ALLOWED_HOSTS=sahara-gold-backend.onrender.com,shaharagold.org,www.shaharagold.org
# Note: Render automatically provides RENDER_EXTERNAL_HOSTNAME, which Django automatically adds.

# Database
# If using Render PostgreSQL: Render automatically sets DATABASE_URL when you link the database.
# If using Neon / Supabase: Paste your connection string here:
# DATABASE_URL=postgresql://user:password@host:5432/sahara_gold?sslmode=require

# Web / Origins (Replace with your actual Render service names)
# e.g. Frontend: https://sahara-gold-store.onrender.com
# e.g. Backend:  https://sahara-gold-api.onrender.com
FRONTEND_URL=https://www.shaharagold.org
BACKEND_URL=https://sahara-gold-backend.onrender.com
CORS_ALLOWED_ORIGINS=https://shaharagold.org,https://www.shaharagold.org,https://sahara-gold-frontend.onrender.com
CSRF_TRUSTED_ORIGINS=https://shaharagold.org,https://www.shaharagold.org
DATABASE_ENGINE=postgresql
# Set REDIS_URL to the existing Render Key Value internal connection URL.
REDIS_URL=
ADMIN_NOTIFICATION_EMAIL=saharagold19@gmail.com

# Deployment preserves existing accounts and products; it never seeds data.
AUTO_POPULATE_DATA=False

# Manual merchant payment is the default. Configure live SSLCommerz credentials
# and explicitly enable it in Admin Settings when ready.
SSLCOMMERZ_IS_SANDBOX=False
ALLOW_SANDBOX_PAYMENTS=False

# Email Backend (Defaults to console logger if password is blank)
# To use Gmail SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-gmail-16-char-app-password
# DEFAULT_FROM_EMAIL=your-email@gmail.com
# STORE_EMAIL=your-email@gmail.com

# AI / LLM Configuration (Optional)
HUGGINGFACE_API_KEY=
AI_MODEL=Qwen/Qwen2.5-72B-Instruct
